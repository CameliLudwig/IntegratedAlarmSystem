             <layout class="QHBoxLayout" name="h_ver">
              <item><widget class="QLineEdit" name="adminPin"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="placeholderText"><string>请输入管理员口令</string></property></widget></item>
              <item><widget class="QPushButton" name="btnVerify"><property name="text"><string>验证</string></property></widget></item>
             </layout>
            </widget>
           </item>

           <!-- 堆叠区域 -->
           <item>
            <widget class="QStackedWidget" name="adminStack">
             <property name="currentIndex"><number>0</number></property>

             <!-- 未验证状态 -->
             <widget class="QWidget" name="pageAdminCompact">
              <layout class="QVBoxLayout" name="v_compact">
               <item>
