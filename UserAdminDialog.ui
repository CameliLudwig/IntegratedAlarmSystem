          <item>
           <widget class="QLabel" name="lblPwdIcon"><property name="text"><string>登录密码</string></property></widget>
          </item>
          <item>
           <widget class="QLineEdit" name="loginPwd">
            <property name="echoMode"><enum>QLineEdit::Password</enum></property>
            <property name="placeholderText"><string>请输入密码</string></property>
           </widget>
          </item>
          <item>
           <spacer name="loginSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer>
          </item>
          <item>
           <widget class="QPushButton" name="btnLogin">
            <property name="text"><string>立即登录</string></property>
            <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           </widget>
          </item>
         </layout>
        </widget>

        <!-- 修改密码页 -->
        <widget class="QWidget" name="pageChange">
         <attribute name="title"><string>修改密码</string></attribute>
         <layout class="QFormLayout" name="formChange">
          <property name="horizontalSpacing"><number>15</number></property>
          <property name="verticalSpacing"><number>15</number></property>
          <property name="topMargin"><number>20</number></property>

          <item row="0" column="0"><widget class="QLabel" name="lc_u"><property name="text"><string>用户名</string></property></widget></item>
          <item row="0" column="1"><widget class="QComboBox" name="cpUserCombo"/></item>

          <item row="1" column="0"><widget class="QLabel" name="lc_o"><property name="text"><string>旧密码</string></property></widget></item>
          <item row="1" column="1"><widget class="QLineEdit" name="cpOldPwd"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>

          <item row="2" column="0"><widget class="QLabel" name="lc_n1"><property name="text"><string>新密码</string></property></widget></item>
          <item row="2" column="1"><widget class="QLineEdit" name="cpNewPwd"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>

          <item row="3" column="0"><widget class="QLabel" name="lc_n2"><property name="text"><string>确认新密码</string></property></widget></item>
          <item row="3" column="1"><widget class="QLineEdit" name="cpNewPwd2"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>

          <item row="4" column="1"><widget class="QPushButton" name="btnCpApply"><property name="text"><string>确认修改</string></property></widget></item>
         </layout>
        </widget>

        <!-- 管理员页 -->
        <widget class="QWidget" name="pageAdmin">
         <attribute name="title"><string>系统管理</string></attribute>
         <layout class="QVBoxLayout" name="v_admin_main">
           <!-- 管理员验证区域 -->
           <item>
