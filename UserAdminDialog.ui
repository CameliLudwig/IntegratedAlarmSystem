        <property name="currentIndex"><number>0</number></property>

        <!-- 登录页 -->
        <widget class="QWidget" name="pageLogin">
         <attribute name="title"><string>身份验证</string></attribute>
         <layout class="QVBoxLayout" name="v_login">
          <property name="spacing"><number>20</number></property>
          <property name="leftMargin"><number>20</number></property>
          <property name="topMargin"><number>30</number></property>
          <property name="rightMargin"><number>20</number></property>
          <property name="bottomMargin"><number>20</number></property>

          <item>
