               </item>
              </layout>
             </widget>

             <!-- 已验证：管理面板 -->
             <widget class="QWidget" name="pageAdminPanel">
              <layout class="QVBoxLayout" name="v_panel">
               <property name="margin"><number>0</number></property>
               <item>
                <widget class="QScrollArea" name="adminScroll">
                 <property name="widgetResizable"><bool>true</bool></property>
                 <widget class="QWidget" name="adminScrollContents">
                  <layout class="QVBoxLayout" name="v_scroll">
                   <item>
                    <widget class="QGroupBox" name="grpUsers">
                     <property name="title"><string>人员数据库</string></property>
                     <layout class="QHBoxLayout" name="h_users">
                      <item>
                       <widget class="QListWidget" name="userList"/>
                      </item>
                      <item>
                       <layout class="QVBoxLayout" name="v_ops">
                        <!-- 添加人员 -->
                        <item>
                         <widget class="QGroupBox" name="gbAdd">
                          <property name="title"><string>新增用户</string></property>
                          <layout class="QFormLayout" name="formAdd">
                           <item row="0" column="0"><widget class="QLabel" name="la1"><property name="text"><string>用户名</string></property></widget></item>
                           <item row="0" column="1"><widget class="QLineEdit" name="addName"/></item>
                           <item row="1" column="0"><widget class="QLabel" name="la2"><property name="text"><string>密码</string></property></widget></item>
                           <item row="1" column="1"><widget class="QLineEdit" name="addPwd"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
                           <item row="2" column="0"><widget class="QLabel" name="la3"><property name="text"><string>确认</string></property></widget></item>
                           <item row="2" column="1"><widget class="QLineEdit" name="addPwd2"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
                           <item row="3" column="1"><widget class="QPushButton" name="btnAdd"><property name="text"><string>添加</string></property></widget></item>
                          </layout>
                         </widget>
                        </item>

                        <!-- 重命名 -->
                        <item>
                         <widget class="QGroupBox" name="gbRename">
                          <property name="title"><string>用户维护</string></property>
                          <layout class="QVBoxLayout" name="v_ren">
                           <item><widget class="QLineEdit" name="renameEdit"><property name="placeholderText"><string>新用户名</string></property></widget></item>
                           <item><widget class="QPushButton" name="btnRename"><property name="text"><string>重命名选中用户</string></property></widget></item>
                          </layout>
                         </widget>
                        </item>

                        <!-- 重置密码 -->
                        <item>
                         <widget class="QGroupBox" name="gbReset">
                          <property name="title"><string>强制重置密码</string></property>
                          <layout class="QFormLayout" name="formReset">
                           <item row="0" column="0"><widget class="QLabel" name="lr1"><property name="text"><string>新密码</string></property></widget></item>
                           <item row="0" column="1"><widget class="QLineEdit" name="resetPwd"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
                           <item row="1" column="0"><widget class="QLabel" name="lr2"><property name="text"><string>确认</string></property></widget></item>
                           <item row="1" column="1"><widget class="QLineEdit" name="resetPwd2"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
                           <item row="2" column="1"><widget class="QPushButton" name="btnReset"><property name="text"><string>重置</string></property></widget></item>
