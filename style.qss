/* ============ 全局背景 ============ */
QMainWindow {
    border-image: url(:/test.png);
}

QWidget#centralWidget {
    background-color: transparent;
}

/* ============ QGroupBox 卡片化 ============ */
QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f5f6f8);
    border: 1px solid #d0d5dc;
    border-radius: 8px;
    margin-top: 18px;
    padding: 16px 12px 12px 12px;
    font-size: 13px;
    font-weight: bold;
    color: #2c3e50;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 2px;
    padding: 4px 16px;
    background-color: #34495e;
    color: #ffffff;
    border-radius: 12px;
    font-size: 12px;
}

/* ================================================================
   每个 GroupBox 的彩色左边框 + 胶囊标题颜色
   ================================================================ */

/* --- 激光告警组 (蓝色 #2980b9) --- */
QGroupBox#groupBox_22{
    border-left: 4px solid #2980b9;
}

QGroupBox#groupBox_22 > QGroupBox::title{
    background-color: #2980b9;
}

/* --- 毫米波雷达 / 烟幕弹 / FlexRay通信 (绿色 #27ae60) --- */
QGroupBox#groupBox_39 {
    border-left: 4px solid #27ae60;
}

QGroupBox#groupBox_39 > QGroupBox::title {
    background-color: #27ae60;
}

/* --- 敌我识别器 (深蓝灰 #2c3e50) --- */
QGroupBox#groupBox_41 {
    border-left: 4px solid #2c3e50;
}
QGroupBox#groupBox_41 > QGroupBox::title {
    background-color: #2c3e50;
}

/* --- 被动8mm波干扰组件 (紫色 #8e44ad) --- */
QGroupBox#groupBox_40 {
    border-left: 4px solid #8e44ad;
}
QGroupBox#groupBox_40 > QGroupBox::title {
    background-color: #8e44ad;
}

/* --- 主机状态 (深蓝 #1a5276) --- */
QGroupBox#groupBox_30 {
    border-left: 4px solid #1a5276;
}
QGroupBox#groupBox_30 > QGroupBox::title {
    background-color: #1a5276;
}

/* --- 任务核心处理机 MP-5 (青蓝 #16a085) --- */
QGroupBox#groupBox_27 {
    border-left: 4px solid #16a085;
}
QGroupBox#groupBox_27 > QGroupBox::title {
    background-color: #16a085;
}

/* --- 识别诸元 (橙色 #e67e22) --- */
QGroupBox#groupBox_32 {
    border-left: 4px solid #e67e22;
}
QGroupBox#groupBox_32 > QGroupBox::title {
    background-color: #e67e22;
}

/* --- 告警诸元 (红色 #c0392b) --- */
QGroupBox#groupBox_33 {
    border-left: 4px solid #c0392b;
}
QGroupBox#groupBox_33 > QGroupBox::title {
    background-color: #c0392b;
}

/* --- 应答诸元 (靛蓝 #34495e) --- */
QGroupBox#groupBox_46 {
    border-left: 4px solid #34495e;
}
QGroupBox#groupBox_46 > QGroupBox::title {
    background-color: #34495e;
}

/* --- 诸元容器 (深灰蓝 #2c3e50) --- */
QGroupBox#groupBox_42 {
    border-left: 4px solid #2c3e50;
}
QGroupBox#groupBox_42 > QGroupBox::title {
    background-color: #2c3e50;
}

/* ============ 按钮 ============ */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5a6c7d, stop:1 #3d4f5f);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: bold;
    min-height: 28px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6c7f91, stop:1 #4d6073);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3d4f5f, stop:1 #2c3e50);
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton:disabled {
    background: #bdc3c7;
    color: #95a5a6;
}

/* 启动自检 -- 绿色 */
QPushButton#pushButton_selfcheck {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ecc71, stop:1 #27ae60);
}
QPushButton#pushButton_selfcheck:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3ddb84, stop:1 #2ecc71);
}
QPushButton#pushButton_selfcheck:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60, stop:1 #1e8449);
}

/* 检测 -- 蓝色 */
QPushButton#pushButton_3 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3498db, stop:1 #2980b9);
}
QPushButton#pushButton_3:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4da8e8, stop:1 #3498db);
}

/* 返回 -- 灰色 */
QPushButton#pushButton_close {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #95a5a6, stop:1 #7f8c8d);
    min-width: 200px;
    font-size: 15px;
}
QPushButton#pushButton_close:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #aab7b8, stop:1 #95a5a6);
}

/* ============ QLineEdit / CircleLineEdit ============ */
QLineEdit {
    background: #ffffff;
    border: 2px solid #d0d5dc;
    border-radius: 6px;
    padding: 4px 8px;
    color: #2c3e50;
    font-size: 12px;
}

QLineEdit:focus {
    border-color: #3498db;
}

/* 告警数值框 -- 大字 */
QLineEdit#lineEdit_AlarmType,
QLineEdit#lineEdit_AlarmDirection,
QLineEdit#lineEdit_31 {
    font-size: 14px;
    font-weight: bold;
}

/* ============ QRadioButton / QCheckBox ============ */
QRadioButton, QCheckBox {
    spacing: 6px;
    color: #2c3e50;
    font-size: 11px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #bdc3c7;
    border-radius: 3px;
    background: #ffffff;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #2980b9;
    border-color: #2980b9;
}

QRadioButton::indicator {
    border-radius: 8px;
}

/* ============ QComboBox ============ */
QComboBox {
    background: #ffffff;
    border: 2px solid #d0d5dc;
    border-radius: 6px;
    padding: 4px 8px;
    color: #2c3e50;
    font-size: 11px;
    min-width: 80px;
}

QComboBox:hover { border-color: #3498db; }
QComboBox:focus { border-color: #2980b9; }

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d0d5dc;
    selection-background-color: #3498db;
}

/* ============ QLabel ============ */
QLabel {
    color: #34495e;
    font-size: 11px;
}

/* ============ QMenuBar ============ */
QMenuBar {
    background-color: #2c3e50;
    color: #ecf0f1;
    padding: 2px;
}
QMenuBar::item:selected {
    background-color: #34495e;
}

/* ============ QStatusBar ============ */
QStatusBar {
    background-color: #ecf0f1;
    color: #7f8c8d;
}

/* ============ QTextBrowser ============ */
QTextBrowser {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d0d5dc;
    border-radius: 6px;
    selection-background-color: #3498db;
    selection-color: #ffffff;
    padding: 6px;
}

/* ============ QTabWidget ============ */
QTabWidget::pane {
    border: 1px solid #d0d5dc;
    border-radius: 6px;
    background-color: #ffffff;
}
QTabBar::tab {
    font-size: 12px;
    font-weight: bold;
    padding: 8px 18px;
    background-color: #e2e8f0;
    color: #64748b;
    border: 1px solid #d0d5dc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2c3e50;
}
QTabBar::tab:hover {
    background-color: #f1f5f9;
}

/* ============ QMessageBox ============ */
QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    color: #2c3e50;
}
QMessageBox QPushButton {
    background-color: #5a6c7d;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
}
QMessageBox QPushButton:hover {
    background-color: #6c7f91;
}

/* ============ 登录 / Adduser ============ */
QWidget#SignIn {
    border-image: url(:/test.png);
}
QMainWindow#Adduser {
    background-color: #e8ecf1;
}
QMainWindow#Adduser QLabel {
    color: #34495e;
    font-size: 14px;
}
QMainWindow#Adduser QLineEdit {
    background: #ffffff;
    border: 2px solid #d0d5dc;
    border-radius: 6px;
    padding: 4px 8px;
}
QMainWindow#Adduser QLineEdit:focus {
    border-color: #3498db;
}
